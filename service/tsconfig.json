{
    "compilerOptions": {
        "target": "es2020",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["es2020"],
        "types": ["node"],
        "strict": true,
        "useUnknownInCatchVariables": false,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "../rescue/src/**/*.ts", "globals.d.ts"]
}
