{
  "name": "tizen-homebrew",
  "version": "0.2.2",
  "private": true,
  "description": "Install apps on a Samsung Tizen TV from your phone.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvndry/tizen-homebrew.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "service",
    "ui"
  ],
  "scripts": {
    "doctor": "node tools/doctor.js",
    "lint": "eslint .",
    "build": "node tools/build.js",
    "test": "node tools/test.js",
    "test:matrix": "node tools/matrix.js",
    "package": "node tools/package.js",
    "bootstrap": "node tools/bootstrap.js",
    "full-bootstrap": "node tools/full-bootstrap.js",
    "duid": "node tools/duid.js",
    "mint": "node tools/mint.js",
    "certs": "node tools/certs.js",
    "push": "node tools/push.js",
    "repl": "node tools/repl.js",
    "dev": "npm run dev --workspace ui",
    "dev:service": "node --require ./tools/dev-global.js service/src/main.ts",
    "clean": "node tools/clean.js",
    "version": "node tools/version.js",
    "version:check": "node tools/version.js --check",
    "version:set": "node tools/version.js --set",
    "typecheck": "npm run typecheck --workspace service && npm run typecheck --workspace ui",
    "rootarm": "node tools/root-arm-build.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "acorn": "^8.14.0",
    "eslint": "^10.9.1",
    "jszip": "^3.10.1",
    "tizen": "https://github.com/reisxd/tizen.js/tarball/main",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@opentui/core": "^0.6.8"
  }
}
